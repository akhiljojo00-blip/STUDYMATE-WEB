rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection verification endpoint
    match /test/{testId} {
      allow get: if true;
    }

    // ==========================================
    // Core Primitive Functions
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ==========================================
    // Entity Validation Blueprints
    // ==========================================
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == request.auth.uid
        && data.email is string && data.email.size() <= 120
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSubject(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'name', 'code', 'description', 'color', 'icon', 'targetHours', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.userId is string && data.userId == request.auth.uid
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 60
        && (!('code' in data) || (data.code is string && data.code.size() <= 20))
        && (!('description' in data) || (data.description is string && data.description.size() <= 280))
        && (!('color' in data) || (data.color is string && data.color.size() <= 30))
        && (!('icon' in data) || (data.icon is string && data.icon.size() <= 30))
        && (!('targetHours' in data) || (data.targetHours is number && data.targetHours >= 0 && data.targetHours <= 168))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTopic(data) {
      return data.keys().hasAll(['id', 'userId', 'subjectId', 'title', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'subjectId', 'title', 'description', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.subjectId)
        && data.userId is string && data.userId == request.auth.uid
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 80
        && (!('description' in data) || (data.description is string && data.description.size() <= 300))
        && data.status in ['not_started', 'learning', 'reviewed']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCard(data) {
      return data.keys().hasAll(['id', 'userId', 'subjectId', 'topicId', 'front', 'back', 'repetition', 'interval', 'easeFactor', 'lapses', 'dueDate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'subjectId', 'topicId', 'front', 'back', 'repetition', 'interval', 'easeFactor', 'lapses', 'dueDate', 'lastReviewedAt', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.subjectId)
        && isValidId(data.topicId)
        && data.userId is string && data.userId == request.auth.uid
        && data.front is string && data.front.size() >= 2 && data.front.size() <= 500
        && data.back is string && data.back.size() >= 1 && data.back.size() <= 1000
        && data.repetition is number && data.repetition >= 0
        && data.interval is number && data.interval >= 0
        && data.easeFactor is number && data.easeFactor >= 1.3
        && data.lapses is number && data.lapses >= 0
        && data.dueDate is string && data.dueDate.size() <= 10
        && (!('lastReviewedAt' in data) || (data.lastReviewedAt is string && data.lastReviewedAt.size() <= 50))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReviewLog(data) {
      return data.keys().hasAll(['id', 'userId', 'cardId', 'subjectId', 'topicId', 'rating', 'quality', 'reviewedAt'])
        && data.keys().hasOnly(['id', 'userId', 'cardId', 'subjectId', 'topicId', 'frontSnippet', 'rating', 'quality', 'previousRepetition', 'newRepetition', 'previousInterval', 'newInterval', 'previousEaseFactor', 'newEaseFactor', 'reviewedAt'])
        && isValidId(data.id)
        && isValidId(data.cardId)
        && isValidId(data.subjectId)
        && isValidId(data.topicId)
        && data.userId is string && data.userId == request.auth.uid
        && (!('frontSnippet' in data) || (data.frontSnippet is string && data.frontSnippet.size() <= 120))
        && data.rating in ['again', 'hard', 'good', 'easy']
        && data.quality is number && (data.quality == 1 || data.quality == 3 || data.quality == 4 || data.quality == 5)
        && (!('previousRepetition' in data) || data.previousRepetition is number)
        && (!('newRepetition' in data) || data.newRepetition is number)
        && (!('previousInterval' in data) || data.previousInterval is number)
        && (!('newInterval' in data) || data.newInterval is number)
        && (!('previousEaseFactor' in data) || data.previousEaseFactor is number)
        && (!('newEaseFactor' in data) || data.newEaseFactor is number)
        && data.reviewedAt is timestamp;
    }

    function isValidDocument(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'fileType', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'subjectId', 'topicId', 'fileType', 'fileSize', 'status', 'textContent', 'summary', 'keyPoints', 'wordCount', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.userId is string && data.userId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && (!('subjectId' in data) || (data.subjectId is string && data.subjectId.size() <= 128))
        && (!('topicId' in data) || (data.topicId is string && data.topicId.size() <= 128))
        && data.fileType is string && data.fileType.size() <= 60
        && (!('fileSize' in data) || (data.fileSize is number && data.fileSize >= 0 && data.fileSize <= 10485760))
        && data.status in ['ready', 'processing', 'error']
        && (!('textContent' in data) || (data.textContent is string && data.textContent.size() <= 500000))
        && (!('summary' in data) || (data.summary is string && data.summary.size() <= 10000))
        && (!('keyPoints' in data) || (data.keyPoints is list && data.keyPoints.size() <= 50))
        && (!('wordCount' in data) || (data.wordCount is number && data.wordCount >= 0))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // ==========================================
    // Collection Rules
    // ==========================================

    // Users Collection: Private user profile, isolated to owner
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false; // Blanket user listing is forbidden
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId
        && isValidUser(incoming())
        && incoming().id == existing().id
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if false;
    }

    // Subjects Collection: Academic subjects owned by students
    match /subjects/{subjectId} {
      allow get: if isSignedIn() && isValidId(subjectId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(subjectId)
        && isValidSubject(incoming())
        && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(subjectId)
        && isValidSubject(incoming())
        && resource.data.userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'code', 'description', 'color', 'icon', 'targetHours', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(subjectId) && resource.data.userId == request.auth.uid;
    }

    // Topics Collection: Curriculum units belonging to subjects
    match /topics/{topicId} {
      allow get: if isSignedIn() && isValidId(topicId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(topicId)
        && isValidTopic(incoming())
        && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(topicId)
        && isValidTopic(incoming())
        && resource.data.userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().subjectId == existing().subjectId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'status', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(topicId) && resource.data.userId == request.auth.uid;
    }

    // Cards Collection: Active-recall flashcards with SM-2 state
    match /cards/{cardId} {
      allow get: if isSignedIn() && isValidId(cardId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(cardId)
        && isValidCard(incoming())
        && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(cardId)
        && isValidCard(incoming())
        && resource.data.userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().subjectId == existing().subjectId
        && incoming().topicId == existing().topicId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['front', 'back', 'repetition', 'interval', 'easeFactor', 'lapses', 'dueDate', 'lastReviewedAt', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(cardId) && resource.data.userId == request.auth.uid;
    }

    // Review Logs: Immutable study review events
    match /review_logs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(logId)
        && isValidReviewLog(incoming())
        && incoming().userId == request.auth.uid;
      allow update: if false; // Logs are immutable historical records
      allow delete: if isSignedIn() && isValidId(logId) && resource.data.userId == request.auth.uid;
    }

    // Documents Collection: Private study materials for Study Library
    match /documents/{docId} {
      allow get: if isSignedIn() && isValidId(docId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(docId)
        && isValidDocument(incoming())
        && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(docId)
        && isValidDocument(incoming())
        && resource.data.userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'subjectId', 'topicId', 'fileType', 'fileSize', 'status', 'textContent', 'summary', 'keyPoints', 'wordCount', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(docId) && resource.data.userId == request.auth.uid;
    }
  }
}
